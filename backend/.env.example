NODE_ENV=production

# Paste your Neon connection string locally or into your hosting provider's secret environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
PEPPER=GENERATE_ANOTHER_LONG_RANDOM_SECRET

CORS_ORIGINS=https://your-sanket-frontend.vercel.app

TRUST_PROXY=1

TIMEZONE_OFFSET_MINUTES=330

BCRYPT_ROUNDS=12
STAFF_SESSION_MINUTES=120
ANON_TOKEN_DAYS=90

JOBS_ENABLED=false
DEV_EXPOSE_OTP=false
