# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/sanket.db

# ── Secrets (REQUIRED in production, min 32 chars each) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PEPPER=

# ── Network ─────────────────────────────────────────────
# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
# Number of reverse-proxy hops in front of the API (0 = none)
TRUST_PROXY=0

# Where the built frontend lives (served by the API when it exists: `npm run build` in ../frontend)
FRONTEND_DIST=../frontend/dist

# ── Behaviour ───────────────────────────────────────────
# Minutes east of UTC used to define "today" and time-of-day periods (IST = 330)
TIMEZONE_OFFSET_MINUTES=330
BCRYPT_ROUNDS=12
STAFF_SESSION_MINUTES=120
ANON_TOKEN_DAYS=90
JOBS_ENABLED=true

# Development only: include the OTP in the login response and print it to the console.
# The server refuses to start with this enabled when NODE_ENV=production.
DEV_EXPOSE_OTP=true

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@sanket.local
SEED_ADMIN_PASSWORD=ChangeMe-Now-2026
