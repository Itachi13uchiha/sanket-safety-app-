# Leave empty in development: the Vite dev server proxies /v1 to the API.
# Set this when the API is hosted on another origin (and add that origin to the API's CORS_ORIGINS):
# VITE_API_URL=https://api.example.com
VITE_API_URL=
# Where the dev-server proxy sends /v1 requests
VITE_API_PROXY_TARGET=http://localhost:4000
